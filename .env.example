# Supabase（Project Settings > API より取得）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 有給管理アプリのDB接続URL（月次エクスポートで有給取得日を読み取る）
LEAVE_DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# 院長ノートPCのIP監視プログラムが許可IPを自動更新するときの合言葉（長いランダム文字列）
IP_AUTO_UPDATE_TOKEN=
